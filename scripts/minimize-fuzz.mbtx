----
import { "moonbitlang/async@0.22.5", "moonbitlang/async@0.22.5/fs", "moonbitlang/async@0.22.5/shell", "moonbitlang/core/env", "moonbitlang/core/json" }
----
async fn main {
  let args = @env.args()
  guard args.length() == 4 else { fail("usage: minimize-fuzz.mbtx <trusted-oracle> <input-hex> <new-output-hex>") }
  guard !@fs.exists(args[3]) && !@fs.exists(args[3] + ".json") else { fail("refusing to overwrite minimizer output") }
  guard @fs.file_size(args[2]) <= 18001L else { fail("sample exceeds one DNS packet") }
  let original = @fs.read_file(args[2]).text().trim().to_owned().to_lower()
  guard original.length() % 2 == 0 else { fail("odd sample hex length") }
  for c in original { guard "0123456789abcdef".find(c.to_string()) is Some(_) else { fail("invalid hex") } }
  @fs.mkdir(".tools", allow_exist=true)
  let candidate_file = ".tools/minimize-candidate.hex"
  let mut attempts = 0
  async fn run(candidate : String) -> Int {
    @fs.write_file(candidate_file, candidate)
    attempts += 1
    let output = @shell.Cmd(args[1], ["--oracle", candidate_file]).output(timeout_ms=1000, max_output_bytes=8192)
    output.exit_code()
  }
  let minimized = @async.with_timeout(15000, () => {
    let signature = run(original)
    guard signature != 0 && run(original) == signature else { fail("sample has no repeatable failure; nothing to minimize") }
    let mut current = original
    let mut granularity = 2
    while current.length() > 0 && attempts < 128 {
      let bytes = current.length() / 2
      let chunk = (bytes + granularity - 1) / granularity
      let mut reduced = false
      for start = 0; start < bytes && attempts < 128; start = start + chunk {
        let end = (start + chunk).min(bytes)
        let candidate = current[0:start*2].to_owned() + current[end*2:].to_owned()
        if run(candidate) == signature {
          current = candidate
          granularity = (granularity - 1).max(2)
          reduced = true
          break
        }
      }
      if !reduced {
        if granularity >= bytes { break }
        granularity = (granularity * 2).min(bytes)
      }
    }
    guard run(current) == signature else { fail("minimized sample failed recheck") }
    (current, signature)
  })
  @fs.write_file(args[3], minimized.0 + "\n")
  let report = Json::object({ "original_bytes": Json(original.length()/2), "minimized_bytes": Json(minimized.0.length()/2), "attempts": Json(attempts), "failure_exit": Json(minimized.1), "rechecked": Json(true) })
  @fs.write_file(args[3] + ".json", report.stringify(indent=2))
  println(report.stringify())
}
