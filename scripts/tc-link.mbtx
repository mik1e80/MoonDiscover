----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

let sender = "moondiscover-tc-send"
let receiver = "moondiscover-tc-recv"
let sender_ip = "192.0.2.9"
let receiver_ip = "192.0.2.10"

async fn command(program : String, args : Array[String]) -> String {
  let result = @shell.Cmd(program, args).output(timeout_ms=8000)
  guard result.exit_code() == 0 else {
    fail(program + " " + args.join(" ") + ": " + result.stderr())
  }
  result.stdout().trim().to_owned()
}

fn in_namespace(ns : String, program : String, args : Array[String]) -> Array[String] {
  let result = ["netns", "exec", ns, program]
  for arg in args { result.push(arg) }
  result
}

async fn tc(args : Array[String]) -> String {
  command("ip", in_namespace(sender, "tc", args))
}

async fn response_tc(args : Array[String]) -> String {
  command("ip", in_namespace(receiver, "tc", args))
}

fn netem_queue(queues : Json) -> Json raise {
  guard queues is Array(entries) else { fail("invalid queue statistics") }
  let netem = entries.filter(entry => entry is { "kind": "netem", "handle": "20:", .. })
  guard netem.length() == 1 else { fail("missing netem statistics: " + queues.stringify()) }
  netem[0]
}

async fn setup_interface(ns : String, device : String, address : String) -> Unit {
  let _ = command("ip", ["-n", ns, "link", "set", "lo", "up"])
  let _ = command("ip", ["-n", ns, "addr", "add", address + "/27", "dev", device])
  let _ = command("ip", ["-n", ns, "link", "set", device, "up"])
  let _ = command("ip", ["-n", ns, "route", "add", "224.0.0.251/32", "dev", device, "src", address])
}

async fn wait_ready(path : String, child : @process.Process, log : String, attempts : Int) -> Unit {
  for _ in 0..<attempts {
    if @fs.exists(path) { return }
    if child.try_wait() is Some(code) {
      fail("process exited \{code}: " + @fs.read_file(log).text())
    }
    @async.sleep(10)
  }
  fail("timed out waiting for " + path + ": " + @fs.read_file(log).text())
}

async fn measure(binary : String, mode : String, trial : Int, additional : Array[String]) -> Json {
  let _ = tc(["qdisc", "add", "dev", "mdtx", "root", "handle", "1:", "prio"])
  defer (ignore(tc(["qdisc", "del", "dev", "mdtx", "root"])))
  let options = match mode {
    "drop" => ["loss", "100%"]
    "reorder" => ["delay", "125ms"]
    _ => ["delay", "0ms"]
  }
  let qdisc = ["qdisc", "add", "dev", "mdtx", "parent", "1:3", "handle", "20:", "netem"]
  for option in options { qdisc.push(option) }
  let _ = tc(qdisc)
  // The only fixture with TC set and two answers carries zc-known. u32 offsets
  // are from the start of the 20-byte IPv4 header: DNS flags at 30, ANCOUNT at 34.
  let _ = tc([
    "filter", "add", "dev", "mdtx", "parent", "1:", "protocol", "ip", "prio", "1",
    "u32", "match", "ip", "protocol", "17", "0xff", "match", "ip", "src", sender_ip + "/32",
    "match", "ip", "dst", "224.0.0.251/32", "match", "ip", "dport", "5353", "0xffff",
    "match", "u16", "0x0200", "0xffff", "at", "30",
    "match", "u16", "2", "0xffff", "at", "34", "flowid", "1:3",
  ])
  let (sent, received) = observe_link(binary, additional)
  let queues = @json.parse(tc(["-j", "-s", "qdisc", "show", "dev", "mdtx"]))
  let sent_order = query_order(additional)
  let expected = sent_order[:sent_order.length() - 2].to_owned()
  if mode == "control" { expected.push(2) }
  expected.push(3)
  if mode == "reorder" { expected.push(2) }
  guard sent is { "queriers": Array(queriers), .. } && queriers.length() == additional.length() + 1 else {
    fail("missing per-querier observations")
  }
  guard sent is { "send_order": order, .. } && order == Json(sent_order) &&
    received is { "receive_order": order, .. } && order == Json(expected) else {
    fail(mode + ": unable to verify sending and arrival order: " + sent.stringify() + " " + received.stringify() + " " + queues.stringify())
  }
  let netem = netem_queue(queues)
  let (packets, drops) = if mode == "drop" { (0, 1) } else { (1, 0) }
  guard netem is { "packets": sent_count, "drops": drop_count, .. } &&
    sent_count == Json(packets) && drop_count == Json(drops) else {
    fail(mode + ": unexpected netem counters: " + queues.stringify())
  }
  Json::object({
    "mode": Json(mode), "trial": Json(trial), "sender": sent,
    "peer": received, "netem": netem,
  })
}

fn query_order(additional : Array[String]) -> Array[Int] {
  let order = [0]
  for i in 0..<additional.length() { order.push(i + 4) }
  for i in 1..=3 { order.push(i) }
  order
}

async fn observe_link(binary : String, additional : Array[String], plain? : Bool = false) -> (Json, Json) {
  let marker = ".tools/tc-link-monitor-ready"
  if @fs.exists(marker) { @fs.remove(marker) }
  let receive_mode = if plain { "--link-observe-qm" } else { "--link-receive" }
  let send_mode = if plain { "--link-baseline" } else { "--link-send" }
  let receive_args = [receive_mode, receiver_ip, sender_ip, marker]
  let send_args = [send_mode, sender_ip, receiver_ip]
  for ip in additional {
    receive_args.push(ip)
    send_args.push(ip)
  }
  @async.with_task_group(group => {
    let out = @process.redirect_to_file(".tools/tc-link-monitor.json")
    let stderr = ".tools/tc-link-monitor.log"
    let err = @process.redirect_to_file(stderr)
    let child = @process.spawn(group, "ip", in_namespace(receiver, binary, receive_args), stdout=out, stderr=err, no_wait=true)
    defer child.cancel()
    wait_ready(marker, child, stderr, 100)
    let sent = @json.parse(command("ip", in_namespace(sender, binary, send_args)))
    guard child.wait() == 0 else { fail("receive probe failed: " + @fs.read_file(stderr).text()) }
    (sent, @fs.read_file(".tools/tc-link-monitor.json").json())
  })
}

async fn plain_query(binary : String) -> Json {
  @json.parse(command("ip", in_namespace(sender, binary, [
    "--link-baseline", sender_ip, receiver_ip,
  ])))
}

async fn attach_query_loss(source : String, rate? : String = "50%") -> Unit {
  let _ = tc(["qdisc", "add", "dev", "mdtx", "parent", "1:3", "handle", "20:", "netem", "loss", rate])
  // QR=0 selects only the isolated sender's multicast DNS queries.
  let _ = tc([
    "filter", "add", "dev", "mdtx", "parent", "1:", "protocol", "ip", "prio", "1",
    "u32", "match", "ip", "protocol", "17", "0xff", "match", "ip", "src", source,
    "match", "ip", "dst", "224.0.0.251/32", "match", "ip", "sport", "5353", "0xffff",
    "match", "ip", "dport", "5353", "0xffff", "match", "u16", "0", "0x8000", "at", "30",
    "flowid", "1:3",
  ])
}

async fn query_queue() -> Json {
  netem_queue(@json.parse(tc(["-j", "-s", "qdisc", "show", "dev", "mdtx"])))
}

async fn measure_random_queries(binary : String, trial : Int) -> Json {
  let _ = tc(["qdisc", "add", "dev", "mdtx", "root", "handle", "1:", "prio"])
  defer (ignore(tc(["qdisc", "del", "dev", "mdtx", "root"])))
  attach_query_loss(sender_ip + "/32")
  let observations : Array[Json] = []
  let mut previous_packets = 0.0
  let mut previous_drops = 0.0
  for _ in 0..<6 {
    @async.sleep(1000)
    let (querier, peer) = observe_link(binary, [], plain=true)
    let queue = query_queue()
    guard querier is { "send_order": order, .. } && order == Json([0]) &&
      queue is { "packets": Number(packets, ..), "drops": Number(drops, ..), .. } else {
      fail("missing outbound query or queue observations")
    }
    let delivered = packets == previous_packets + 1.0 && drops == previous_drops
    let lost = packets == previous_packets && drops == previous_drops + 1.0
    let observed = if delivered {
      peer is { "receive_order": [0], .. } &&
      querier is { "zeroconf": { "known_ptr_ms": Number(_, ..), "unknown_ptr_ms": Number(_, ..), .. }, .. }
    } else {
      lost && peer is { "receive_order": [], .. } &&
      querier is { "zeroconf": { "known_ptr_ms": Null, "unknown_ptr_ms": Null, .. }, .. }
    }
    guard observed else {
      fail("query queue, peer and response disagree: " + querier.stringify() + " " + peer.stringify() + " " + queue.stringify())
    }
    observations.push(Json::object({
      "delivered": Json(delivered), "querier": querier, "peer": peer, "netem": queue,
    }))
    previous_packets = packets
    previous_drops = drops
  }
  Json::object({ "trial": Json(trial), "observations": Json::array(observations) })
}

async fn attach_response_netem(policy : String, value : String, two_answers? : Bool = false) -> Unit {
  let _ = response_tc(["qdisc", "add", "dev", "mdrx", "parent", "1:3", "handle", "20:", "netem", policy, value])
  // QR is the high bit of the DNS flags at offset 30. Queries traverse the
  // unmodified mdtx egress; this queue sees only peer IPv4 multicast replies.
  let filter = [
    "filter", "add", "dev", "mdrx", "parent", "1:", "protocol", "ip", "prio", "1",
    "u32", "match", "ip", "protocol", "17", "0xff", "match", "ip", "src", receiver_ip + "/32",
    "match", "ip", "dst", "224.0.0.251/32", "match", "ip", "sport", "5353", "0xffff",
    "match", "ip", "dport", "5353", "0xffff", "match", "u16", "0x8000", "0x8000", "at", "30",
  ]
  if two_answers {
    for arg in ["match", "u16", "2", "0xffff", "at", "34"] { filter.push(arg) }
  }
  filter.push("flowid")
  filter.push("1:3")
  let _ = response_tc(filter)
}

async fn response_queue() -> Json {
  netem_queue(@json.parse(response_tc(["-j", "-s", "qdisc", "show", "dev", "mdrx"])))
}

async fn release_bursts(hold_ms : Int) -> Json {
  @async.sleep(hold_ms)
  let query = query_queue()
  guard query is { "packets": Number(0, ..), "drops": Number(drops, ..), .. } && drops > 0.0 else {
    fail("no query was dropped during the overlapping outage: " + query.stringify())
  }
  let _ = tc(["qdisc", "change", "dev", "mdtx", "parent", "1:3", "handle", "20:", "netem", "loss", "0%"])
  let mut response = Json::null()
  let checks = if hold_ms >= 10000 { 650 } else if hold_ms > 500 { 420 } else { 110 }
  for _ in 0..<checks {
    response = response_queue()
    if response is { "drops": Number(drops, ..), .. } && drops > 0.0 { break }
    @async.sleep(20)
  }
  @async.sleep(hold_ms)
  response = response_queue()
  guard response is { "packets": Number(0, ..), "drops": Number(drops, ..), .. } && drops > 0.0 else {
    fail("no response was dropped during the outage: " + response.stringify())
  }
  let _ = response_tc(["qdisc", "change", "dev", "mdrx", "parent", "1:3", "handle", "20:", "netem", "loss", "0%"])
  Json::object({ "hold_after_loss_ms": Json(hold_ms), "query_before_reopen": query, "response_before_reopen": response })
}

async fn observe_retry(binary : String, additional : Array[String], trial : Int, queue : async () -> Json, window_seconds? : Int = 0, burst_hold_ms? : Int = 0) -> Json {
  let (observed, first, phases) = @async.with_task_group(group => {
    let path = ".tools/tc-link-multi-retry.log"
    let error_log = ".tools/tc-link-multi-retry-error.log"
    let mode = if window_seconds == 0 { "--link-multi-retry" } else { "--link-retry-\{window_seconds}s" }
    let args = [mode, sender_ip]
    for ip in additional { args.push(ip) }
    let out = @process.redirect_to_file(path)
    let err = @process.redirect_to_file(error_log)
    let child = @process.spawn(group, "ip", in_namespace(sender, binary, args), stdout=out, stderr=err, no_wait=true)
    defer child.cancel()
    let mut first = Json::null()
    for _ in 0..<150 {
      first = queue()
      if first is { "packets": Number(sent, ..), "drops": Number(dropped, ..), .. } && sent + dropped > 0.0 { break }
      if child.try_wait() is Some(_) { break }
      @async.sleep(15)
    }
    let phases = if burst_hold_ms > 0 { release_bursts(burst_hold_ms) } else { Json::null() }
    guard child.wait() == 0 else { fail("multi-Browser probe failed: " + @fs.read_file(error_log).text()) }
    (@fs.read_file(path).json(), first, phases)
  })
  let final_queue = queue()
  guard observed is { "queriers": Array(queriers), .. } && queriers.length() == additional.length() + 1 &&
    first is { "packets": Number(sent, ..), "drops": Number(dropped, ..), .. } && sent + dropped > 0.0 &&
    final_queue is { "packets": Number(delivered, ..), "drops": Number(lost, ..), .. } &&
    delivered >= sent && lost >= dropped else {
    fail("missing multi-Browser or kernel observations: " + observed.stringify() + " " + first.stringify() + " " + final_queue.stringify())
  }
  let lagged = sent == 0.0 && dropped > 0.0 &&
    queriers.any(q => q is { "qm_ms": [_, _, ..], .. }) &&
    queriers.all(q => q is { "resolved_ms": Number(_, ..), .. })
  let result = Json::object({
    "trial": Json(trial), "browsers": observed, "first_netem": first, "final_netem": final_queue,
    "observation_window_ms": Json(if window_seconds == 0 { 7800 } else { window_seconds * 1000 }),
    "all_resolved_after_initial_block_and_retransmission": Json(lagged),
  })
  if burst_hold_ms > 0 && result is Object(fields) { fields["burst"] = phases }
  result
}

async fn measure_multi_retry(binary : String, additional : Array[String], trial : Int) -> Json {
  let _ = response_tc(["qdisc", "add", "dev", "mdrx", "root", "handle", "1:", "prio"])
  defer (ignore(response_tc(["qdisc", "del", "dev", "mdrx", "root"])))
  attach_response_netem("loss", "50%")
  observe_retry(binary, additional, trial, response_queue)
}

async fn measure_query_retry(binary : String, additional : Array[String], trial : Int, window_seconds? : Int = 0, burst_hold_ms? : Int = 0) -> Json {
  let _ = tc(["qdisc", "add", "dev", "mdtx", "root", "handle", "1:", "prio"])
  defer (ignore(tc(["qdisc", "del", "dev", "mdtx", "root"])))
  attach_query_loss("192.0.2.0/27", rate=if burst_hold_ms > 0 { "100%" } else { "50%" })
  let ready = ".tools/tc-retry-peer-ready"
  let done = ".tools/tc-retry-peer-done"
  for marker in [ready, done] {
    if @fs.exists(marker) { @fs.remove(marker) }
  }
  let (result, peer) = @async.with_task_group(group => {
    let mode = if window_seconds == 0 { "--link-retry-peer" } else { "--link-retry-peer-\{window_seconds}s" }
    let args = [mode, receiver_ip, ready, done, sender_ip]
    for ip in additional { args.push(ip) }
    let log = ".tools/tc-link-retry-peer.log"
    let error_log = ".tools/tc-link-retry-peer-error.log"
    let out = @process.redirect_to_file(log)
    let err = @process.redirect_to_file(error_log)
    let monitor = @process.spawn(group, "ip", in_namespace(receiver, binary, args), stdout=out, stderr=err, no_wait=true)
    defer monitor.cancel()
    wait_ready(ready, monitor, error_log, 100)
    let result = observe_retry(binary, additional, trial, query_queue, window_seconds~, burst_hold_ms~)
    @fs.write_file(done, "")
    guard monitor.wait() == 0 else { fail("query monitor failed: " + @fs.read_file(error_log).text()) }
    (result, @fs.read_file(log).json())
  })
  guard result is Object(fields) &&
    result is { "final_netem": { "packets": passed, .. }, .. } &&
    peer is { "query_packets": received, .. } && passed == received else {
    fail("query queue and peer counts disagree: " + result.stringify() + " " + peer.stringify())
  }
  fields["peer"] = peer
  result
}

async fn measure_bidirectional_retry(binary : String, additional : Array[String], trial : Int, window_seconds? : Int = 0, burst_hold_ms? : Int = 0) -> Json {
  let _ = response_tc(["qdisc", "add", "dev", "mdrx", "root", "handle", "1:", "prio"])
  defer (ignore(response_tc(["qdisc", "del", "dev", "mdrx", "root"])))
  attach_response_netem("loss", if burst_hold_ms > 0 { "100%" } else { "50%" })
  let result = measure_query_retry(binary, additional, trial, window_seconds~, burst_hold_ms~)
  let response = response_queue()
  guard result is Object(fields) &&
    result is { "browsers": { "queriers": Array(queriers), .. }, .. } &&
    response is { "packets": Number(passed, ..), .. } &&
    (passed > 0.0 || queriers.all(q => q is { "resolved_ms": Null, .. })) else {
    fail("Browser resolved without a response traversing netem: " + result.stringify() + " " + response.stringify())
  }
  fields["response_netem"] = response
  result
}

async fn measure_reply_order(binary : String, mode : String, trial : Int, browser? : Bool = false) -> Json {
  let _ = response_tc(["qdisc", "add", "dev", "mdrx", "root", "handle", "1:", "prio"])
  defer (ignore(response_tc(["qdisc", "del", "dev", "mdrx", "root"])))
  let delay = if mode == "reorder" { "125ms" } else { "0ms" }
  attach_response_netem("delay", delay, two_answers=true)
  let marker = ".tools/tc-reply-order-ready"
  if @fs.exists(marker) { @fs.remove(marker) }
  let (sent, received) = @async.with_task_group(group => {
    let log = ".tools/tc-reply-order.log"
    let error_log = ".tools/tc-reply-order-error.log"
    let out = @process.redirect_to_file(log)
    let err = @process.redirect_to_file(error_log)
    let receive_mode = if browser { "--browser-reply-receive" } else { "--reply-receive" }
    let send_mode = if browser { "--browser-reply-send" } else { "--reply-send" }
    let monitor = @process.spawn(group, "ip", in_namespace(sender, binary, [
      receive_mode, sender_ip, receiver_ip, marker,
    ]), stdout=out, stderr=err, no_wait=true)
    defer monitor.cancel()
    wait_ready(marker, monitor, error_log, 100)
    let sent = @json.parse(command("ip", in_namespace(receiver, binary, [
      send_mode, receiver_ip,
    ])))
    guard monitor.wait() == 0 else { fail("response receive probe failed: " + @fs.read_file(error_log).text()) }
    (sent, @fs.read_file(log).json())
  })
  let queue = response_queue()
  let expected = if mode == "reorder" { [1, 0] } else { [0, 1] }
  let decoded = if browser {
    received is { "complete": true, .. }
  } else {
    received is { "first_ptr_ms": Number(_, ..), "second_ptr_ms": Number(_, ..), .. }
  }
  guard sent is { "order": send_order, .. } && send_order == Json([0, 1]) &&
    received is { "order": recv_order, .. } && recv_order == Json(expected) && decoded &&
    queue is { "packets": Number(1, ..), "drops": Number(0, ..), .. } else {
    fail("unexpected response order or queue result: " + sent.stringify() + " " + received.stringify() + " " + queue.stringify())
  }
  Json::object({ "trial": Json(trial), "mode": Json(mode), "sent": sent, "received": received, "netem": queue })
}

async fn measure_multi_response(binary : String, mode : String, trial : Int, additional : Array[String]) -> Json {
  let _ = response_tc(["qdisc", "add", "dev", "mdrx", "root", "handle", "1:", "prio"])
  defer (ignore(response_tc(["qdisc", "del", "dev", "mdrx", "root"])))
  let (policy, value) = match mode {
    "drop" => ("loss", "100%")
    "delay" => ("delay", "125ms")
    _ => ("delay", "0ms")
  }
  attach_response_netem(policy, value)
  let (sent, peer) = observe_link(binary, additional)
  let queue = response_queue()
  let expected_order = Json(query_order(additional))
  guard sent is { "send_order": order, "queriers": Array(queriers), .. } &&
    order == expected_order && queriers.length() == additional.length() + 1 &&
    peer is { "receive_order": arrival, .. } && arrival == expected_order else {
    fail("some queries did not cross the unmodified link: " + sent.stringify() + " " + peer.stringify())
  }
  if mode == "drop" {
    guard queue is { "packets": Number(0, ..), "drops": Number(drops, ..), .. } &&
      drops >= 1.0 &&
      queriers.all(q => q is { "zeroconf": { "known_ptr_ms": Null, "unknown_ptr_ms": Null, .. }, .. }) else {
      fail("response loss was not observed at every querier: " + sent.stringify() + " " + queue.stringify())
    }
  } else {
    let minimum = if mode == "delay" { 125.0 } else { 0.0 }
    guard queue is { "packets": Number(packets, ..), "drops": Number(0, ..), .. } &&
      packets >= 1.0 &&
      queriers.all(q => q is { "zeroconf": { "known_ptr_ms": Number(known, ..), "unknown_ptr_ms": Number(unknown, ..), .. }, .. } &&
        known >= minimum && unknown >= minimum) else {
      fail("missing or premature response: " + sent.stringify() + " " + queue.stringify())
    }
  }
  Json::object({ "mode": Json(mode), "trial": Json(trial), "sender": sent, "peer": peer, "netem": queue })
}

async fn measure_responses(binary : String, mode : String, trial : Int) -> Json {
  let _ = response_tc(["qdisc", "add", "dev", "mdrx", "root", "handle", "1:", "prio"])
  defer (ignore(response_tc(["qdisc", "del", "dev", "mdrx", "root"])))
  let (policy, value, attempts) = match mode {
    "drop" => ("loss", "100%", 2)
    "random" => ("loss", "50%", 6)
    "delay" => ("delay", "125ms", 1)
    _ => ("delay", "0ms", 1)
  }
  attach_response_netem(policy, value)
  let observations : Array[Json] = []
  let mut last_drops = 0.0
  let mut last_sent = 0.0
  for _ in 0..<attempts {
    @async.sleep(1000)
    let result = plain_query(binary)
    let queue = response_queue()
    if mode == "random" {
      guard queue is { "packets": Number(sent, ..), "drops": Number(drops, ..), .. } &&
        sent >= last_sent && drops >= last_drops && sent + drops > last_sent + last_drops else {
        fail("random-loss attempt did not reach netem: " + queue.stringify())
      }
      if sent == last_sent {
        guard result is { "zeroconf": { "known_ptr_ms": Null, "unknown_ptr_ms": Null, .. }, .. } else {
          fail("received a PTR without a response leaving netem: " + result.stringify())
        }
      }
      if drops == last_drops {
        guard result is { "zeroconf": { "known_ptr_ms": Number(_, ..), "unknown_ptr_ms": Number(_, ..), .. }, .. } else {
          fail("a lossless attempt did not deliver both PTRs: " + result.stringify())
        }
      }
      last_sent = sent
      last_drops = drops
    } else if mode == "drop" {
      guard result is { "zeroconf": { "known_ptr_ms": Null, "unknown_ptr_ms": Null, .. }, .. } &&
        queue is { "packets": Number(0, ..), "drops": Number(drops, ..), .. } && drops > last_drops else {
        fail("response loss was not observed: " + result.stringify() + " " + queue.stringify())
      }
      last_drops = drops
    } else {
      let minimum = if mode == "delay" { 125.0 } else { 0.0 }
      guard result is { "zeroconf": { "known_ptr_ms": Number(known, ..), "unknown_ptr_ms": Number(unknown, ..), .. }, .. } &&
        known >= minimum && unknown >= minimum &&
        queue is { "packets": Number(sent, ..), "drops": Number(0, ..), .. } && sent >= 1.0 else {
        fail("unexpected response delivery: " + result.stringify() + " " + queue.stringify())
      }
    }
    observations.push(Json::object({ "querier": result, "netem": queue }))
  }
  Json::object({ "mode": Json(mode), "trial": Json(trial), "observations": Json::array(observations) })
}

async fn measure_retry(binary : String, trial : Int) -> Json {
  let restored = ".tools/tc-link-retry-restored"
  if @fs.exists(restored) { @fs.remove(restored) }
  let _ = response_tc(["qdisc", "add", "dev", "mdrx", "root", "handle", "1:", "prio"])
  defer (ignore(response_tc(["qdisc", "del", "dev", "mdrx", "root"])))
  attach_response_netem("loss", "100%")
  let (observed, lost) = @async.with_task_group(group => {
    let log = ".tools/tc-link-retry.log"
    let error_log = ".tools/tc-link-retry-error.log"
    let out = @process.redirect_to_file(log)
    let err = @process.redirect_to_file(error_log)
    let child = @process.spawn(group, "ip", in_namespace(sender, binary, [
      "--link-retry", sender_ip, restored,
    ]), stdout=out, stderr=err, no_wait=true)
    defer child.cancel()
    let mut queue = Json::null()
    for _ in 0..<110 {
      guard child.try_wait() is None else {
        fail("Browser probe ended before link restoration: " + @fs.read_file(error_log).text())
      }
      queue = response_queue()
      if queue is { "drops": Number(n, ..), .. } && n >= 2.0 { break }
      @async.sleep(25)
    }
    guard queue is { "drops": Number(2, ..), "packets": Number(0, ..), .. } else {
      fail("expected two blocked responses: " + queue.stringify())
    }
    let _ = response_tc(["qdisc", "change", "dev", "mdrx", "parent", "1:3", "handle", "20:", "netem", "loss", "0%"])
    @fs.write_file(restored, "")
    guard child.wait() == 0 else { fail("Browser retry probe failed: " + @fs.read_file(error_log).text()) }
    (@fs.read_file(log).json(), queue)
  })
  Json::object({ "trial": Json(trial), "browser": observed, "blocked": lost, "restored": response_queue() })
}

async fn main {
  let args = @env.args()
  let response = args.get(3) == Some("--response")
  let multi_response = args.get(3) == Some("--multi-response")
  let advanced = args.get(3) == Some("--advanced-response")
  let retry = args.get(3) == Some("--retry")
  let random = args.get(3) == Some("--random-response")
  let random_query = args.get(3) == Some("--random-query")
  let mode = args.get(3)
  let long_burst = mode is Some("--multi-bidirectional-burst-5s" | "--multi-bidirectional-burst-10s")
  let extended_random = mode is Some("--bidirectional-30s" | "--bidirectional-60s" | "--bidirectional-120s")
  let burst = long_burst || mode == Some("--multi-bidirectional-burst")
  let window_seconds = match mode {
    Some("--bidirectional-120s") => 120
    Some("--bidirectional-60s" | "--multi-bidirectional-burst-10s") => 60
    Some("--bidirectional-30s" | "--multi-bidirectional-burst-5s") => 30
    _ => 0
  }
  let burst_hold_ms = if mode == Some("--multi-bidirectional-burst-10s") { 10000 } else if long_burst { 5000 } else if burst { 500 } else { 0 }
  let bidirectional = extended_random || burst || args.get(3) is Some("--bidirectional-retry" | "--multi-bidirectional-retry")
  let query_retry = bidirectional || args.get(3) is Some("--query-retry" | "--multi-query-retry")
  let last_octet = match args.get(3) {
    None | Some("--response") | Some("--retry") | Some("--random-response") | Some("--random-query") | Some("--query-retry") | Some("--bidirectional-retry") | Some("--bidirectional-30s") | Some("--bidirectional-60s") | Some("--bidirectional-120s") => 10
    Some("--five") => 14
    Some("--six") => 15
    Some("--seven") => 16
    Some("--eight") => 17
    Some("--nine") => 18
    Some("--ten") => 19
    Some("--eleven") => 20
    Some("--twelve") | Some("--multi-response") | Some("--advanced-response") | Some("--multi-query-retry") | Some("--multi-bidirectional-retry") | Some("--multi-bidirectional-burst") | Some("--multi-bidirectional-burst-5s") | Some("--multi-bidirectional-burst-10s") => 21
    _ => 0
  }
  guard args.length() >= 3 && args.length() <= 4 && last_octet >= 10 else {
    fail("usage: tc-link.mbtx <zeroconf-python> <source-commit> [--response|--multi-response|--advanced-response|--retry|--random-response|--random-query|--query-retry|--multi-query-retry|--bidirectional-retry|--multi-bidirectional-retry|--bidirectional-30s|--bidirectional-60s|--bidirectional-120s|--multi-bidirectional-burst|--multi-bidirectional-burst-5s|--multi-bidirectional-burst-10s|--five|--six|--seven|--eight|--nine|--ten|--eleven|--twelve]")
  }
  let additional : Array[String] = []
  for i in 11..=last_octet { additional.push("192.0.2.\{i}") }
  @fs.mkdir(".tools", allow_exist=true)
  let binary = "_build/native/debug/build/tests/tc_interop/tc_interop.exe"
  let python = args[1]
  // These namespaces must be new. Neither the qdisc nor the virtual interfaces
  // are attached to a pre-existing namespace or the runner's physical NIC.
  let _ = command("ip", ["netns", "add", sender])
  defer (ignore(command("ip", ["netns", "del", sender])))
  let _ = command("ip", ["netns", "add", receiver])
  defer (ignore(command("ip", ["netns", "del", receiver])))
  let _ = command("ip", ["-n", sender, "link", "add", "mdtx", "type", "veth", "peer", "name", "mdrx", "netns", receiver])
  setup_interface(sender, "mdtx", sender_ip)
  setup_interface(receiver, "mdrx", receiver_ip)
  for ip in additional {
    let _ = command("ip", ["-n", sender, "addr", "add", ip + "/32", "dev", "mdtx"])
  }
  let marker = ".tools/tc-link-publisher-ready"
  if @fs.exists(marker) { @fs.remove(marker) }
  let (baseline, arms) = @async.with_task_group(group => {
    let log = ".tools/tc-link-publisher.log"
    let output = @process.redirect_to_file(log)
    let publisher_args = ["tests/interop/tc_publisher.py", receiver_ip, marker]
    if window_seconds == 120 { publisher_args.push("1050") }
    else if window_seconds == 60 && long_burst { publisher_args.push("220") }
    else if window_seconds == 60 { publisher_args.push("550") }
    else if extended_random { publisher_args.push("300") }
    else if long_burst { publisher_args.push("120") }
    let publisher = @process.spawn(group, "ip", in_namespace(receiver, python, publisher_args), stdout=output, stderr=output, no_wait=true)
    defer publisher.cancel()
    wait_ready(marker, publisher, log, 1000)
    @async.sleep(2300)
    let baseline = plain_query(binary)
    guard baseline is { "zeroconf": { "known_ptr_ms": Number(_), "unknown_ptr_ms": Number(_), .. }, .. } else {
      fail("plain baseline did not receive both registered PTRs: " + baseline.stringify())
    }
    let arms : Array[Json] = []
    if query_retry {
      let trials = if burst { 3 } else { 8 }
      for trial in 1..=trials {
        @async.sleep(1100)
        let result = if bidirectional {
          measure_bidirectional_retry(binary, additional, trial, window_seconds~, burst_hold_ms~)
        } else {
          measure_query_retry(binary, additional, trial)
        }
        arms.push(result)
      }
      guard extended_random || arms.any(a => a is { "all_resolved_after_initial_block_and_retransmission": true, .. }) else {
        fail("no observed recovery after initial query loss: " + Json(arms).stringify())
      }
      if bidirectional {
        guard arms.any(a => a is { "response_netem": { "drops": Number(drops, ..), .. }, .. } && drops > 0.0) else {
          fail("no response loss observed in the bidirectional sample: " + Json(arms).stringify())
        }
      }
    } else if advanced {
      for trial in 1..=8 {
        @async.sleep(1100)
        arms.push(measure_multi_retry(binary, additional, trial))
      }
      guard arms.any(a => a is { "all_resolved_after_initial_block_and_retransmission": true, .. }) else {
        fail("no recovery after an initially blocked response: " + Json(arms).stringify())
      }
    }
    for trial in 1..=(if advanced || query_retry { 0 } else { 3 }) {
      if multi_response {
        for mode in ["control", "drop", "restored", "delay"] {
          @async.sleep(800)
          arms.push(measure_multi_response(binary, mode, trial, additional))
        }
      } else if retry {
        @async.sleep(1100)
        arms.push(measure_retry(binary, trial))
      } else if random_query {
        arms.push(measure_random_queries(binary, trial))
      } else if random {
        arms.push(measure_responses(binary, "random", trial))
      } else if response {
        for mode in ["control", "drop", "restored", "delay"] {
          arms.push(measure_responses(binary, mode, trial))
        }
      } else {
        for mode in ["control", "drop", "reorder"] {
          @async.sleep(800)
          arms.push(measure(binary, mode, trial, additional))
        }
      }
    }
    guard publisher.try_wait() is None else { fail("publisher exited during measurements") }
    (baseline, arms)
  })
  let reordered : Array[Json] = []
  let browser_reordered : Array[Json] = []
  if advanced {
    for trial in 1..=3 {
      for mode in ["control", "reorder"] { reordered.push(measure_reply_order(binary, mode, trial)) }
      for mode in ["control", "reorder"] { browser_reordered.push(measure_reply_order(binary, mode, trial, browser=true)) }
    }
  }
  let report = Json::object({
    "source_commit": Json(args[2]),
    "scenario": if extended_random {
      "one Browser with isolated veth bidirectional random loss over \{window_seconds} seconds"
    } else if long_burst {
      "twelve Browsers with overlapping bidirectional bursts held \{burst_hold_ms / 1000} seconds"
    } else if burst {
      "twelve Browsers with overlapping bidirectional bursts"
    } else if bidirectional {
      if additional.is_empty() { "one Browser with isolated veth bidirectional random loss" }
      else { "twelve Browsers with isolated veth bidirectional random loss" }
    } else if query_retry {
      if additional.is_empty() { "one Browser with isolated veth random query loss" }
      else { "twelve Browsers with isolated veth random query loss" }
    } else if random_query { "isolated veth random query loss" } else if advanced { "twelve Browsers with random response loss and isolated response reorder" } else if multi_response { "twelve queriers with isolated veth response faults" } else if retry { "Browser automatic retry across isolated veth" } else if random { "isolated veth random response loss" } else if response { "isolated veth response loss, restore and delay" } else { match additional.length() {
      11 => "twelve queriers with isolated veth TC loss and reordering"
      10 => "eleven queriers with isolated veth TC loss and reordering"
      9 => "ten queriers with isolated veth TC loss and reordering"
      8 => "nine queriers with isolated veth TC loss and reordering"
      7 => "eight queriers with isolated veth TC loss and reordering"
      6 => "seven queriers with isolated veth TC loss and reordering"
      5 => "six queriers with isolated veth TC loss and reordering"
      4 => "five queriers with isolated veth TC loss and reordering"
      _ => "isolated veth TC loss and reordering"
    } },
    "kernel": Json(command("uname", ["-r"])),
    "zeroconf_version": Json(command(python, ["-c", "from importlib.metadata import version; print(version('zeroconf'))"])),
    "baseline": baseline,
    "arms": Json::array(arms),
  })
  if advanced {
    guard report is Object(fields) else { fail("invalid report") }
    fields["response_reorder"] = Json::array(reordered)
    fields["browser_response_reorder"] = Json::array(browser_reordered)
  }
  let path = if extended_random {
    ".tools/tc-bidirectional-\{window_seconds}s.json"
  } else if long_burst {
    ".tools/tc-multi-bidirectional-burst-\{burst_hold_ms / 1000}s.json"
  } else if burst {
    ".tools/tc-multi-bidirectional-burst.json"
  } else if bidirectional {
    if additional.is_empty() { ".tools/tc-bidirectional-retry-link.json" } else { ".tools/tc-multi-bidirectional-retry-link.json" }
  } else if query_retry {
    if additional.is_empty() { ".tools/tc-query-retry-link.json" } else { ".tools/tc-multi-query-retry-link.json" }
  } else if random_query { ".tools/tc-random-query-link.json" } else if advanced { ".tools/tc-advanced-response-link.json" } else if multi_response { ".tools/tc-multi-response-link.json" } else if retry { ".tools/tc-retry-link.json" } else if random { ".tools/tc-random-response-link.json" } else if response { ".tools/tc-response-link.json" } else { ".tools/tc-link.json" }
  @fs.write_file(path, report.stringify(indent=2) + "\n")
  println(report.stringify())
}
